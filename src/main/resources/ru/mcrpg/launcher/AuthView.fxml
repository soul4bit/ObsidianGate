<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ru.mcrpg.launcher.AuthController"
           styleClass="launcher-shell, auth-shell">
    <children>
        <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                   onMouseDragged="#dragWindow" onMousePressed="#captureWindowDrag"
                   styleClass="auth-scene">
            <children>
                <Region styleClass="auth-scene-overlay"/>

                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="auth-scroll">
                    <content>
                        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308"
                              maxWidth="1.7976931348623157E308" minHeight="568.0" spacing="54.0"
                              styleClass="auth-layout">
                            <children>
                                <VBox fx:id="authBrandPanel"
                                      alignment="CENTER_LEFT" maxWidth="500.0" spacing="16.0"
                                      styleClass="auth-brand-panel">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <ImageView fitHeight="46.0" fitWidth="46.0" preserveRatio="true"
                                                           smooth="false" styleClass="brand-image">
                                                    <image>
                                                        <Image url="@assets/clean-glass/obsidiangate-sidebar-logo.png"/>
                                                    </image>
                                                </ImageView>
                                                <Label styleClass="auth-brand-title" text="OBSIDIANGATE"/>
                                            </children>
                                        </HBox>
                                        <Label styleClass="auth-hero-title" text="Вход"/>
                                        <Label styleClass="auth-hero-copy"
                                               text="Запустите лаунчер и вернитесь на сервер своим игровым профилем."
                                               wrapText="true"/>
                                        <Label fx:id="versionLabel" styleClass="version-badge" text="Лаунчер"/>
                                    </children>
                                </VBox>

                                <VBox fx:id="authCard"
                                      maxWidth="440.0" minWidth="440.0" prefWidth="440.0"
                                      spacing="18.0" styleClass="auth-card">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="auth-card-title" text="Войти в аккаунт"/>
                                                <Label styleClass="muted" text="Используйте email или никнейм"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="14.0" styleClass="auth-form">
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="Email или логин"/>
                                                        <TextField fx:id="loginField" promptText="Введите email или логин"
                                                                   styleClass="auth-input"/>
                                                        <Label fx:id="loginErrorLabel" managed="false"
                                                               styleClass="field-error" visible="false" wrapText="true"/>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label styleClass="field-label" text="Пароль"/>
                                                        <PasswordField fx:id="passwordField" promptText="Введите пароль"
                                                                       styleClass="auth-input"/>
                                                        <Label fx:id="passwordErrorLabel" managed="false"
                                                               styleClass="field-error" visible="false" wrapText="true"/>
                                                    </children>
                                                </VBox>

                                                <CheckBox fx:id="rememberCheck" text="Запомнить меня"/>

                                                <Label fx:id="statusLabel" styleClass="status-error" wrapText="true"/>

                                                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308"
                                                        mnemonicParsing="false" onAction="#onLogin"
                                                        styleClass="auth-primary-button" text="Войти"/>

                                                <HBox alignment="CENTER" fillHeight="false" spacing="12.0"
                                                      styleClass="auth-divider-row">
                                                    <children>
                                                        <Region HBox.hgrow="ALWAYS" styleClass="auth-divider-line"/>
                                                        <Label styleClass="auth-divider-label" text="или"/>
                                                        <Region HBox.hgrow="ALWAYS" styleClass="auth-divider-line"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER" spacing="8.0">
                                                    <children>
                                                        <Label styleClass="muted" text="Нет аккаунта?"/>
                                                        <Hyperlink fx:id="openRegisterLink" onAction="#openRegister"
                                                                   text="Зарегистрироваться"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </ScrollPane>

                <fx:include fx:id="windowControls" source="clean-glass-window-controls.fxml"
                            StackPane.alignment="TOP_RIGHT"/>
            </children>
            <padding>
                <Insets bottom="32.0" left="44.0" right="44.0" top="44.0"/>
            </padding>
        </StackPane>
    </children>
</StackPane>
