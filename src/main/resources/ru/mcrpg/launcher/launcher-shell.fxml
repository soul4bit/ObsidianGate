<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="launcherShellRoot"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ru.mcrpg.launcher.LauncherShellController"
           styleClass="launcher-shell">
    <children>
        <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
              minHeight="0.0" minWidth="0.0"
              onMouseDragged="#dragWindow" onMousePressed="#captureWindowDrag"
              spacing="12.0" styleClass="launcher-window">
            <children>
                <fx:include fx:id="sidebar" source="clean-glass-sidebar.fxml"/>

                <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           HBox.hgrow="ALWAYS" styleClass="main-stack">
                    <children>
                        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                              styleClass="main">
                            <children>
                                <StackPane fx:id="heroCard"
                                           maxHeight="390.0" maxWidth="1.7976931348623157E308"
                                           minHeight="390.0" prefHeight="390.0"
                                           styleClass="hero-card">
                                    <children>
                                        <Region styleClass="hero-overlay"/>
                                        <Region fx:id="heroParallaxLayer" maxHeight="1.7976931348623157E308"
                                                maxWidth="1.7976931348623157E308" mouseTransparent="true"
                                                styleClass="hero-parallax-layer"/>
                                        <Region fx:id="heroPortalGlow" maxHeight="284.0" maxWidth="300.0"
                                                minHeight="284.0" minWidth="300.0" mouseTransparent="true"
                                                prefHeight="284.0" prefWidth="300.0"
                                                styleClass="hero-portal-glow" StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="150.0" top="34.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Region fx:id="heroPortalCore" maxHeight="206.0" maxWidth="124.0"
                                                minHeight="206.0" minWidth="124.0" mouseTransparent="true"
                                                prefHeight="206.0" prefWidth="124.0"
                                                styleClass="hero-portal-core" StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="238.0" top="46.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Region fx:id="heroPortalSweep" maxHeight="206.0" maxWidth="58.0"
                                                minHeight="206.0" minWidth="58.0" mouseTransparent="true"
                                                prefHeight="206.0" prefWidth="58.0"
                                                styleClass="hero-portal-sweep" StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="270.0" top="46.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Region fx:id="heroPortalShardOne" mouseTransparent="true"
                                                styleClass="hero-portal-shard, shard-one"
                                                StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="342.0" top="-124.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Region fx:id="heroPortalShardTwo" mouseTransparent="true"
                                                styleClass="hero-portal-shard, shard-two"
                                                StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="206.0" top="104.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Region fx:id="heroPortalShardThree" mouseTransparent="true"
                                                styleClass="hero-portal-shard, shard-three"
                                                StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="356.0" top="148.0"/>
                                            </StackPane.margin>
                                        </Region>
                                        <Label mouseTransparent="true" styleClass="hero-corner-mark" text="✦"
                                               StackPane.alignment="TOP_LEFT">
                                            <StackPane.margin>
                                                <Insets left="18.0" top="14.0"/>
                                            </StackPane.margin>
                                        </Label>
                                        <fx:include fx:id="windowControls" source="clean-glass-window-controls.fxml"
                                                    StackPane.alignment="TOP_RIGHT"/>
                                        <VBox alignment="CENTER_LEFT" maxWidth="610.0" spacing="0.0"
                                              StackPane.alignment="CENTER_LEFT" styleClass="hero-content">
                                            <children>
                                                <Label styleClass="hero-kicker" text="Добро пожаловать,"/>
                                                <Label fx:id="heroTitleLabel" styleClass="hero-title" text="Игрок!"/>
                                                <Label styleClass="hero-subtitle"
                                                       text="Готов к новым приключениям на ObsidianGate?"/>
                                                <HBox alignment="CENTER_LEFT" spacing="34.0" styleClass="hero-actions">
                                                    <children>
                                                        <Button fx:id="playButton" mnemonicParsing="false"
                                                                onAction="#play" styleClass="play-button" text="Играть"/>
                                                        <VBox spacing="8.0" styleClass="version-block">
                                                            <children>
                                                                <Label styleClass="version-label" text="Версия сборки"/>
                                                                <Label fx:id="buildVersionLabel" styleClass="version-title" text="Загрузка..."/>
                                                                <Label fx:id="forgeVersionBadgeLabel" styleClass="version-badge"
                                                                       text="Forge -"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="14.0"/>
                                    </VBox.margin>
                                </StackPane>

                                <GridPane maxHeight="260.0"
                                          maxWidth="1.7976931348623157E308"
                                          minHeight="260.0" prefHeight="260.0"
                                          hgap="16.0" styleClass="dashboard-grid">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="34.13"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="26.62"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="39.25"/>
                                    </columnConstraints>
                                    <children>
                                        <VBox fx:id="serverCard"
                                              maxHeight="260.0"
                                              maxWidth="1.7976931348623157E308"
                                              minHeight="260.0" prefHeight="260.0" spacing="14.0"
                                              styleClass="card, server-card"
                                              GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-header">
                                                    <children>
                                                        <Label styleClass="card-title" text="Статус сервера"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="online">
                                                            <children>
                                                                <Region fx:id="serverStatusDot" styleClass="status-dot"/>
                                                                <Label fx:id="serverStatusLabel" styleClass="online-text" text="Проверка"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="server-address">
                                                    <children>
                                                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true"
                                                                   smooth="true" styleClass="server-cube">
                                                            <image>
                                                                <Image url="@assets/clean-glass/obsidiangate-sidebar-logo.png"/>
                                                            </image>
                                                        </ImageView>
                                                        <Label fx:id="serverAddressLabel"
                                                               maxWidth="1.7976931348623157E308"
                                                               styleClass="server-address-text"
                                                               text="obsidiangates.duckdns.org:25565" HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="copyIpIconButton" mnemonicParsing="false"
                                                                onAction="#copyServerIp" styleClass="icon-button"/>
                                                    </children>
                                                </HBox>

                                                <GridPane hgap="0.0" styleClass="server-stats">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="33.33"/>
                                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="33.33"/>
                                                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="33.34"/>
                                                    </columnConstraints>
                                                    <children>
                                                        <VBox alignment="CENTER" spacing="4.0" styleClass="stat"
                                                              GridPane.columnIndex="0">
                                                            <children>
                                                                <Label fx:id="playersIconLabel" styleClass="stat-icon"/>
                                                                <Label styleClass="stat-label" text="Игроки"/>
                                                                <Label fx:id="playersValueLabel" styleClass="stat-value" text="-"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="4.0" styleClass="stat"
                                                              GridPane.columnIndex="1">
                                                            <children>
                                                                <Label fx:id="pingIconLabel" styleClass="stat-icon"/>
                                                                <Label styleClass="stat-label" text="Пинг"/>
                                                                <Label fx:id="pingValueLabel" styleClass="stat-value" text="-"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER" spacing="4.0" styleClass="stat"
                                                              GridPane.columnIndex="2">
                                                            <children>
                                                                <Label fx:id="versionIconLabel" styleClass="stat-icon"/>
                                                                <Label styleClass="stat-label" text="Версия"/>
                                                                <Label fx:id="versionValueLabel" styleClass="stat-value" text="-"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>

                                                <Region VBox.vgrow="ALWAYS"/>

                                                <HBox spacing="10.0" styleClass="server-actions">
                                                    <children>
                                                        <Button fx:id="copyIpButton" maxWidth="1.7976931348623157E308"
                                                                mnemonicParsing="false" onAction="#copyServerIp"
                                                                styleClass="btn-outline" text="Копировать IP"
                                                                HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="meetingButton" maxWidth="1.7976931348623157E308"
                                                                mnemonicParsing="false" onAction="#openMeeting"
                                                                styleClass="btn-outline, meeting-button" text="Телемост"
                                                                HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox fx:id="syncCard"
                                              alignment="TOP_CENTER" maxHeight="260.0"
                                              maxWidth="1.7976931348623157E308" minHeight="260.0"
                                              prefHeight="260.0" spacing="0.0"
                                              styleClass="card, sync-card" GridPane.columnIndex="1"
                                              GridPane.hgrow="ALWAYS">
                                            <children>
                                                <Label maxWidth="1.7976931348623157E308" styleClass="card-title"
                                                       text="Синхронизация файлов"/>
                                                <StackPane fx:id="syncProgressWrap"
                                                           maxHeight="122.0" maxWidth="122.0" minHeight="122.0"
                                                           minWidth="122.0" prefHeight="122.0" prefWidth="122.0"
                                                           styleClass="progress-wrap">
                                                    <children>
                                                        <Circle radius="54.0" styleClass="progress-track-shape"/>
                                                        <Arc fx:id="syncProgressArc" length="0.0" radiusX="54.0" radiusY="54.0"
                                                             startAngle="90.0" strokeLineCap="ROUND"
                                                             styleClass="progress-value-shape" type="OPEN"/>
                                                        <Pane maxHeight="108.0" maxWidth="108.0"
                                                              minHeight="108.0" minWidth="108.0"
                                                              mouseTransparent="true"
                                                              prefHeight="108.0" prefWidth="108.0">
                                                            <children>
                                                                <Arc fx:id="syncActivityArc"
                                                                     centerX="54.0" centerY="54.0"
                                                                     length="-72.0" opacity="0.0"
                                                                     radiusX="54.0" radiusY="54.0"
                                                                     startAngle="90.0" strokeLineCap="ROUND"
                                                                     styleClass="progress-activity-shape" type="OPEN"/>
                                                            </children>
                                                        </Pane>
                                                        <Label fx:id="syncProgressLabel" styleClass="progress-label" text="0%"/>
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets bottom="6.0" top="22.0"/>
                                                    </VBox.margin>
                                                </StackPane>
                                                <Label fx:id="syncStatusLabel" alignment="CENTER"
                                                       maxWidth="1.7976931348623157E308"
                                                       styleClass="sync-size" text="Готово" wrapText="true"/>
                                                <Label fx:id="syncDetailLabel" alignment="CENTER"
                                                       maxWidth="1.7976931348623157E308"
                                                       styleClass="sync-detail" text="0 файлов · 0 Б"
                                                       wrapText="true"/>
                                                <Region VBox.vgrow="ALWAYS"/>
                                            </children>
                                        </VBox>

                                        <VBox fx:id="newsCard"
                                              maxHeight="260.0"
                                              maxWidth="1.7976931348623157E308"
                                              minHeight="260.0" prefHeight="260.0" spacing="0.0"
                                              styleClass="card, news-card"
                                              GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-header">
                                                    <children>
                                                        <Label styleClass="card-title" text="Новости обновлений"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Button mnemonicParsing="false" onAction="#openNews"
                                                                styleClass="news-button" text="Все новости"/>
                                                    </children>
                                                </HBox>

                                                <VBox fx:id="newsListBox" spacing="10.0" styleClass="news-list">
                                                    <children>
                                                        <Label styleClass="news-text" text="Загрузка новостей..."/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Label fx:id="updatedAtLabel" minHeight="26.0" prefHeight="26.0"
                                       styleClass="footer" text="Обновлено: -">
                                    <VBox.margin>
                                        <Insets top="14.0"/>
                                    </VBox.margin>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</StackPane>
