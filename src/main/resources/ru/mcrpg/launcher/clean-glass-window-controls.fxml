<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mcrpg.launcher.CleanGlassWindowControlsController"
      alignment="CENTER_RIGHT" maxHeight="44.0" maxWidth="94.0"
      minHeight="44.0" minWidth="94.0" prefHeight="44.0"
      prefWidth="94.0" styleClass="hero-controls">
    <children>
        <Button fx:id="minimizeWindowButton" mnemonicParsing="false"
                onAction="#minimizeWindow" styleClass="window-button"/>
        <Button fx:id="closeWindowButton" mnemonicParsing="false"
                onAction="#closeWindow" styleClass="window-button"/>
    </children>
</HBox>
