<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ru.mcrpg.launcher.SettingsController"
           styleClass="launcher-shell, settings-shell">
    <children>
        <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
              minHeight="0.0" minWidth="0.0"
              onMouseDragged="#dragWindow" onMousePressed="#captureWindowDrag"
              spacing="12.0" styleClass="launcher-window">
            <children>
                <fx:include fx:id="sidebar" source="clean-glass-sidebar.fxml"/>

                <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           HBox.hgrow="ALWAYS" styleClass="main-stack">
                    <children>
                        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                              styleClass="main, settings-main">
                            <children>
                                <StackPane fx:id="settingsHeroCard"
                                           maxHeight="170.0" maxWidth="1.7976931348623157E308"
                                           minHeight="170.0" prefHeight="170.0"
                                           styleClass="settings-page-hero">
                                    <children>
                                        <Region styleClass="settings-page-hero-overlay"/>
                                        <Label mouseTransparent="true" styleClass="hero-corner-mark" text="✦"
                                               StackPane.alignment="TOP_LEFT">
                                            <StackPane.margin>
                                                <Insets left="18.0" top="14.0"/>
                                            </StackPane.margin>
                                        </Label>
                                        <fx:include fx:id="windowControls" source="clean-glass-window-controls.fxml"
                                                    StackPane.alignment="TOP_RIGHT"/>
                                        <VBox alignment="CENTER_LEFT" maxWidth="760.0" spacing="8.0"
                                              StackPane.alignment="CENTER_LEFT" styleClass="settings-page-hero-content">
                                            <children>
                                                <Label styleClass="hero-kicker" text="Параметры лаунчера"/>
                                                <HBox alignment="CENTER_LEFT" spacing="18.0">
                                                    <children>
                                                        <Label styleClass="settings-page-title" text="Настройки"/>
                                                        <Label fx:id="versionLabel" styleClass="version-badge"
                                                               text="Лаунчер"/>
                                                    </children>
                                                </HBox>
                                                <Label styleClass="settings-page-subtitle"
                                                       text="Клиент, память, подключение и запуск ObsidianGate"/>
                                                <Label fx:id="statusLabel" maxWidth="560.0" styleClass="settings-status"
                                                       text="Готово" wrapText="true"/>
                                            </children>
                                        </VBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="14.0"/>
                                    </VBox.margin>
                                </StackPane>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            styleClass="content-scroll, settings-scroll"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="16.0" styleClass="settings-content">
                                            <children>
                                                <HBox spacing="16.0" styleClass="settings-grid">
                                                    <children>
                                                        <VBox maxWidth="380.0" minWidth="300.0" prefWidth="360.0"
                                                              spacing="16.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <VBox fx:id="settingsPrimaryCard"
                                                                      spacing="16.0" styleClass="settings-card, settings-primary-card">
                                                                    <children>
                                                                        <HBox alignment="CENTER_LEFT" spacing="10.0"
                                                                              styleClass="card-header">
                                                                            <children>
                                                                                <Label fx:id="clientIconLabel"
                                                                                       styleClass="profile-card-icon"/>
                                                                                <VBox spacing="3.0">
                                                                                    <children>
                                                                                        <Label styleClass="section-title"
                                                                                               text="Основное"/>
                                                                                        <Label styleClass="muted"
                                                                                               text="Папка сборки, Java и выделенная память"/>
                                                                                    </children>
                                                                                </VBox>
                                                                            </children>
                                                                        </HBox>

                                                                        <VBox spacing="7.0">
                                                                            <children>
                                                                                <Label styleClass="field-label"
                                                                                       text="Папка игры"/>
                                                                                <HBox spacing="10.0">
                                                                                    <children>
                                                                                        <TextField fx:id="gameDirectoryField"
                                                                                                   maxWidth="1.7976931348623157E308"
                                                                                                   promptText="C:\Users\Player\rpg-client"
                                                                                                   styleClass="settings-input"
                                                                                                   HBox.hgrow="ALWAYS"/>
                                                                                        <Button fx:id="browseGameDirectoryButton"
                                                                                                mnemonicParsing="false"
                                                                                                onAction="#onBrowseGameDirectory"
                                                                                                styleClass="settings-icon-button"/>
                                                                                    </children>
                                                                                </HBox>
                                                                            </children>
                                                                        </VBox>

                                                                        <VBox spacing="7.0">
                                                                            <children>
                                                                                <Label styleClass="field-label" text="Java"/>
                                                                                <HBox spacing="10.0">
                                                                                    <children>
                                                                                        <TextField fx:id="javaCommandField"
                                                                                                   maxWidth="1.7976931348623157E308"
                                                                                                   promptText="java"
                                                                                                   styleClass="settings-input"
                                                                                                   HBox.hgrow="ALWAYS"/>
                                                                                        <Button fx:id="browseJavaButton"
                                                                                                mnemonicParsing="false"
                                                                                                onAction="#onBrowseJavaCommand"
                                                                                                styleClass="settings-icon-button"/>
                                                                                    </children>
                                                                                </HBox>
                                                                            </children>
                                                                        </VBox>

                                                                        <VBox spacing="10.0">
                                                                            <children>
                                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Память"/>
                                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                                        <Label fx:id="memorySummaryLabel"
                                                                                               styleClass="settings-inline-status"
                                                                                               text="4 GB"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <HBox spacing="8.0" styleClass="settings-segmented">
                                                                                    <children>
                                                                                        <ToggleButton fx:id="memory2Button"
                                                                                                      mnemonicParsing="false"
                                                                                                      text="2 GB"/>
                                                                                        <ToggleButton fx:id="memory4Button"
                                                                                                      mnemonicParsing="false"
                                                                                                      text="4 GB"/>
                                                                                        <ToggleButton fx:id="memory6Button"
                                                                                                      mnemonicParsing="false"
                                                                                                      text="6 GB"/>
                                                                                        <ToggleButton fx:id="memory8Button"
                                                                                                      mnemonicParsing="false"
                                                                                                      text="8 GB"/>
                                                                                        <ToggleButton fx:id="memoryManualButton"
                                                                                                      mnemonicParsing="false"
                                                                                                      text="Вручную"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <HBox fx:id="manualMemoryBox" managed="false"
                                                                                      spacing="14.0" visible="false">
                                                                                    <children>
                                                                                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                                                                            <children>
                                                                                                <Label styleClass="field-label"
                                                                                                       text="Мин. RAM, MB"/>
                                                                                                <TextField fx:id="memoryMinField"
                                                                                                           promptText="1024"
                                                                                                           styleClass="settings-input"/>
                                                                                            </children>
                                                                                        </VBox>
                                                                                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                                                                            <children>
                                                                                                <Label styleClass="field-label"
                                                                                                       text="Макс. RAM, MB"/>
                                                                                                <TextField fx:id="memoryMaxField"
                                                                                                           promptText="4096"
                                                                                                           styleClass="settings-input"/>
                                                                                            </children>
                                                                                        </VBox>
                                                                                    </children>
                                                                                </HBox>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </VBox>

                                                            </children>
                                                        </VBox>

                                                        <VBox fx:id="settingsConnectionCard"
                                                              maxWidth="380.0" minWidth="300.0" prefWidth="360.0"
                                                              spacing="16.0" styleClass="settings-card, settings-connection-card"
                                                              HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <HBox alignment="CENTER_LEFT" spacing="10.0"
                                                                              styleClass="card-header">
                                                                            <children>
                                                                                <Label fx:id="serverIconLabel"
                                                                                       styleClass="profile-card-icon"/>
                                                                                <VBox spacing="3.0">
                                                                                    <children>
                                                                                        <Label styleClass="section-title"
                                                                                               text="Подключение"/>
                                                                                        <Label styleClass="muted"
                                                                                               text="Minecraft-сервер, manifest и Auth API"/>
                                                                                    </children>
                                                                                </VBox>
                                                                            </children>
                                                                        </HBox>

                                                                        <HBox spacing="14.0">
                                                                            <children>
                                                                                <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Адрес сервера"/>
                                                                                        <TextField fx:id="serverHostField"
                                                                                                   promptText="obsidiangates.duckdns.org"
                                                                                                   styleClass="settings-input"/>
                                                                                    </children>
                                                                                </VBox>
                                                                                <VBox minWidth="118.0" prefWidth="118.0"
                                                                                      spacing="7.0">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Порт"/>
                                                                                        <TextField fx:id="serverPortField"
                                                                                                   promptText="25565"
                                                                                                   styleClass="settings-input"/>
                                                                                    </children>
                                                                                </VBox>
                                                                            </children>
                                                                        </HBox>

                                                                        <VBox spacing="7.0">
                                                                            <children>
                                                                                <Label styleClass="field-label"
                                                                                       text="Manifest URL"/>
                                                                                <TextField fx:id="manifestUrlField"
                                                                                           maxWidth="1.7976931348623157E308"
                                                                                           promptText="http://host:8080/manifest.json"
                                                                                           styleClass="settings-input"/>
                                                                                <Label styleClass="field-hint"
                                                                                       text="Опасное поле: URL управляет составом сборки и обновлениями файлов."
                                                                                       wrapText="true"/>
                                                                            </children>
                                                                        </VBox>

                                                                        <VBox spacing="7.0">
                                                                            <children>
                                                                                <Label styleClass="field-label"
                                                                                       text="Auth API URL"/>
                                                                                <TextField fx:id="authBaseUrlField"
                                                                                           maxWidth="1.7976931348623157E308"
                                                                                           promptText="http://host:8081"
                                                                                           styleClass="settings-input"/>
                                                                                <Label styleClass="field-hint"
                                                                                       text="Меняйте только если переносите сервер авторизации или тестируете стенд."
                                                                                       wrapText="true"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </VBox>

                                                        <VBox maxWidth="360.0" minWidth="330.0" prefWidth="350.0"
                                                              spacing="16.0">
                                                            <children>
                                                                <VBox fx:id="settingsActionsCard"
                                                                      spacing="12.0"
                                                                      styleClass="settings-card, settings-actions-card">
                                                                    <children>
                                                                        <Button fx:id="saveButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onSaveSettings"
                                                                                styleClass="settings-save-button"
                                                                                text="Сохранить"/>
                                                                        <VBox spacing="10.0" styleClass="settings-check-list">
                                                                            <children>
                                                                                <CheckBox fx:id="launcherUpdatesEnabledCheck"
                                                                                          text="Обновления лаунчера проверяются всегда"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </VBox>

                                                                <VBox fx:id="settingsQuickActionsCard"
                                                                      spacing="12.0" styleClass="settings-card">
                                                                    <children>
                                                                        <Label styleClass="section-title"
                                                                               text="Быстрые действия"/>
                                                                        <Button fx:id="resetButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onResetDefaults"
                                                                                styleClass="profile-action-button"
                                                                                text="Сбросить по умолчанию"/>
                                                                        <Button fx:id="openGameDirectoryButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onOpenGameDirectory"
                                                                                styleClass="profile-action-button"
                                                                                text="Открыть папку игры"/>
                                                                        <Button fx:id="openConfigButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onOpenConfigFile"
                                                                                styleClass="profile-action-button"
                                                                                text="Открыть файл настроек"/>
                                                                    </children>
                                                                </VBox>

                                                                <TitledPane animated="true" expanded="false"
                                                                            styleClass="settings-advanced-pane"
                                                                            text="Расширенные">
                                                                    <content>
                                                                        <VBox fx:id="settingsAdvancedCard"
                                                                              spacing="14.0"
                                                                              styleClass="settings-card, settings-advanced-content">
                                                                            <children>
                                                                                <HBox alignment="CENTER_LEFT" spacing="10.0"
                                                                                      styleClass="card-header">
                                                                                    <children>
                                                                                        <Label fx:id="launchIconLabel"
                                                                                               styleClass="profile-card-icon"/>
                                                                                        <Label styleClass="section-title"
                                                                                               text="Запуск"/>
                                                                                    </children>
                                                                                </HBox>

                                                                                <VBox spacing="7.0">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Рабочая папка"/>
                                                                                        <HBox spacing="10.0">
                                                                                            <children>
                                                                                                <TextField fx:id="workingDirectoryField"
                                                                                                           maxWidth="1.7976931348623157E308"
                                                                                                           promptText="по умолчанию: папка игры"
                                                                                                           styleClass="settings-input"
                                                                                                           HBox.hgrow="ALWAYS"/>
                                                                                                <Button fx:id="browseWorkingDirectoryButton"
                                                                                                        mnemonicParsing="false"
                                                                                                        onAction="#onBrowseWorkingDirectory"
                                                                                                        styleClass="settings-icon-button"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </VBox>

                                                                                <VBox spacing="7.0">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Server ID"/>
                                                                                        <TextField fx:id="serverIdField"
                                                                                                   maxWidth="1.7976931348623157E308"
                                                                                                   promptText="obsidiangate-main"
                                                                                                   styleClass="settings-input"/>
                                                                                    </children>
                                                                                </VBox>

                                                                                <VBox spacing="7.0">
                                                                                    <children>
                                                                                        <Label styleClass="field-label"
                                                                                               text="Шаблон команды"/>
                                                                                        <TextArea fx:id="launchTemplateArea"
                                                                                                  prefRowCount="8"
                                                                                                  promptText="{java} -jar forge.jar --username {username}"
                                                                                                  styleClass="settings-textarea"
                                                                                                  wrapText="true"/>
                                                                                    </children>
                                                                                </VBox>
                                                                            </children>
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="8.0"/>
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</StackPane>
