<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ru.mcrpg.launcher.ProfileController"
           styleClass="launcher-shell, profile-shell">
    <children>
        <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
              minHeight="0.0" minWidth="0.0"
              onMouseDragged="#dragWindow" onMousePressed="#captureWindowDrag"
              spacing="12.0" styleClass="launcher-window">
            <children>
                <fx:include fx:id="sidebar" source="clean-glass-sidebar.fxml"/>

                <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           HBox.hgrow="ALWAYS" styleClass="main-stack">
                    <children>
                        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                              styleClass="main, profile-main">
                            <children>
                                <StackPane fx:id="profileHeroCard"
                                           maxHeight="230.0" maxWidth="1.7976931348623157E308"
                                           minHeight="230.0" prefHeight="230.0"
                                           styleClass="profile-page-hero">
                                    <children>
                                        <Region styleClass="profile-page-hero-overlay"/>
                                        <Label mouseTransparent="true" styleClass="hero-corner-mark" text="✦"
                                               StackPane.alignment="TOP_LEFT">
                                            <StackPane.margin>
                                                <Insets left="18.0" top="14.0"/>
                                            </StackPane.margin>
                                        </Label>
                                        <fx:include fx:id="windowControls" source="clean-glass-window-controls.fxml"
                                                    StackPane.alignment="TOP_RIGHT"/>

                                        <HBox alignment="CENTER_LEFT" spacing="22.0"
                                              StackPane.alignment="CENTER_LEFT" styleClass="profile-page-hero-content">
                                            <children>
                                                <StackPane maxHeight="108.0" maxWidth="108.0" minHeight="108.0"
                                                           minWidth="108.0" prefHeight="108.0" prefWidth="108.0"
                                                           styleClass="profile-hero-avatar-wrap">
                                                    <children>
                                                        <ImageView fx:id="profileAvatarView" fitHeight="88.0"
                                                                   fitWidth="88.0" preserveRatio="true"
                                                                   smooth="false" styleClass="profile-hero-avatar">
                                                            <image>
                                                                <Image url="@assets/player-avatar.png"/>
                                                            </image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>

                                                <VBox minWidth="0.0" spacing="9.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                                                            <children>
                                                                <Label styleClass="hero-kicker" text="Профиль игрока"/>
                                                                <Label fx:id="versionLabel" styleClass="version-badge"
                                                                       text="Лаунчер"/>
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="profileNameLabel" styleClass="profile-hero-name"
                                                               text="Игрок"/>
                                                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                                                            <children>
                                                                <Label fx:id="profileRoleBadgeLabel"
                                                                       styleClass="profile-role-badge" text="Игрок"/>
                                                                <HBox alignment="CENTER_LEFT" spacing="7.0">
                                                                    <children>
                                                                        <Region styleClass="profile-online-dot"/>
                                                                        <Label fx:id="profileStatusLabel"
                                                                               styleClass="profile-online-text"
                                                                               text="В сети"/>
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="profileWelcomeLabel" styleClass="profile-hero-copy"
                                                               text="Добро пожаловать на ObsidianGate"/>
                                                    </children>
                                                </VBox>

                                                <Button fx:id="editProfileButton" mnemonicParsing="false"
                                                        onAction="#onEditProfile" styleClass="profile-edit-button"
                                                        text="Редактировать"/>
                                            </children>
                                        </HBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="14.0"/>
                                    </VBox.margin>
                                </StackPane>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            styleClass="content-scroll, profile-scroll"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="16.0" styleClass="profile-content">
                                            <children>
                                                <HBox spacing="16.0" styleClass="profile-dashboard-grid">
                                                    <children>
                                                        <VBox fx:id="accountInfoCard"
                                                              minWidth="0.0" prefWidth="520.0" spacing="14.0"
                                                              styleClass="profile-card, account-info-card"
                                                              HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0"
                                                                      styleClass="card-header">
                                                                    <children>
                                                                        <Label fx:id="accountInfoIconLabel"
                                                                               styleClass="profile-card-icon"/>
                                                                        <Label styleClass="section-title"
                                                                               text="Информация об аккаунте"/>
                                                                    </children>
                                                                </HBox>
                                                                <VBox spacing="0.0" styleClass="profile-info-list">
                                                                    <children>
                                                                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                                              styleClass="profile-info-row">
                                                                            <children>
                                                                                <Label fx:id="usernameIconLabel"
                                                                                       styleClass="profile-info-icon"/>
                                                                                <Label styleClass="muted" text="Ник"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="accountUsernameLabel"
                                                                                       styleClass="value-label"
                                                                                       text="-"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                                              styleClass="profile-info-row">
                                                                            <children>
                                                                                <Label fx:id="roleIconLabel"
                                                                                       styleClass="profile-info-icon"/>
                                                                                <Label styleClass="muted" text="Роль"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="accountRoleLabel"
                                                                                       styleClass="accent-purple"
                                                                                       text="-"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                                              styleClass="profile-info-row">
                                                                            <children>
                                                                                <Label fx:id="emailIconLabel"
                                                                                       styleClass="profile-info-icon"/>
                                                                                <Label styleClass="muted" text="Email"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="profileEmailLabel"
                                                                                       maxWidth="300.0"
                                                                                       styleClass="value-label" text="-"
                                                                                       wrapText="true"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                                                                              styleClass="profile-info-row">
                                                                            <children>
                                                                                <Label fx:id="accountIdIconLabel"
                                                                                       styleClass="profile-info-icon"/>
                                                                                <Label styleClass="muted"
                                                                                       text="ID аккаунта"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="accountIdLabel"
                                                                                       maxWidth="300.0"
                                                                                       styleClass="profile-id-value"
                                                                                       text="-" wrapText="true"/>
                                                                            </children>
                                                                        </HBox>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </VBox>

                                                        <VBox fx:id="quickActionsCard"
                                                              maxWidth="340.0" minWidth="315.0" prefWidth="330.0"
                                                              spacing="14.0" styleClass="profile-card, quick-actions-card">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0"
                                                                      styleClass="card-header">
                                                                    <children>
                                                                        <Label fx:id="quickActionsIconLabel"
                                                                               styleClass="profile-card-icon"/>
                                                                        <Label styleClass="section-title"
                                                                               text="Быстрые действия"/>
                                                                    </children>
                                                                </HBox>
                                                                <VBox spacing="10.0">
                                                                    <children>
                                                                        <Button fx:id="switchAccountButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onSwitchAccount"
                                                                                styleClass="profile-action-button"
                                                                                text="Сменить аккаунт"/>
                                                                        <Button fx:id="openGameFolderButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onOpenGameFolder"
                                                                                styleClass="profile-action-button"
                                                                                text="Открыть папку игры"/>
                                                                        <Button fx:id="logoutButton"
                                                                                maxWidth="1.7976931348623157E308"
                                                                                mnemonicParsing="false"
                                                                                onAction="#onLogout"
                                                                                styleClass="profile-action-button, profile-logout-button"
                                                                                text="Выйти из аккаунта"/>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <HBox fx:id="securityCard"
                                                      alignment="CENTER_LEFT" spacing="14.0"
                                                      styleClass="profile-card, profile-security-card">
                                                    <children>
                                                        <Label fx:id="securityIconLabel" styleClass="profile-security-icon"/>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="profile-security-title"
                                                                       text="Профиль защищён"/>
                                                                <Label fx:id="sessionExpiresLabel" styleClass="muted"
                                                                       text="Сессия активна"/>
                                                                <Label fx:id="statusLabel"
                                                                       styleClass="profile-sync-status"
                                                                       wrapText="true"/>
                                                            </children>
                                                        </VBox>
                                                        <Button fx:id="securityDetailsButton" mnemonicParsing="false"
                                                                onAction="#onShowSecurityDetails"
                                                                styleClass="profile-details-button"
                                                                text="Подробнее"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="8.0"/>
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</StackPane>
