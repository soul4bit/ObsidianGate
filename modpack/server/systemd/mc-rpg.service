[Unit]
Description=MC RPG Forge 1.12.2 Server
After=network.target

[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/home/minecraft/mc-rpg
ExecStart=/usr/lib/jvm/java-8-openjdk-amd64/jre/bin/java -Dfml.queryResult=confirm -Dobsidiangate.authBaseUrl=http://127.0.0.1:8081 -Dobsidiangate.serverId=obsidiangate-main -Dobsidiangate.authGraceSeconds=60 -Xms2G -Xmx4G -XX:+UseG1GC -XX:+UnlockExperimentalVMOptions -XX:+ParallelRefProcEnabled -XX:+UseStringDeduplication -XX:MaxGCPauseMillis=200 -XX:G1NewSizePercent=20 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -jar /home/minecraft/mc-rpg/server.jar nogui
Restart=always
RestartSec=10
KillSignal=SIGINT
SuccessExitStatus=0 143
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
